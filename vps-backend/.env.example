# Copy this file to ".env" in this same folder and fill in the real values
# directly on the VPS. Never commit the real ".env" file or paste these
# values anywhere else (chat, docs, etc).

# --- ZarinPal (payment) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0
SITE_URL=https://vaarz.ir

# --- Supabase (shared by payment + password reset) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Farapayamak (SMS password-reset codes) ---
# From your Farapayamak panel (https://ippanel.com or payamak-panel.com):
#   FARAPAYAMAK_USERNAME / FARAPAYAMAK_PASSWORD -> your panel login.
#   FARAPAYAMAK_PATTERN_CODE -> the numeric "کد پترن" you get after Farapayamak
#     approves a pattern for the reset-code message, e.g. a pattern whose body
#     is: "کد بازیابی رمز عبور ورز: %code%"
FARAPAYAMAK_USERNAME=
FARAPAYAMAK_PASSWORD=
FARAPAYAMAK_PATTERN_CODE=

# --- CORS ---
CORS_ORIGIN=*
PORT=3000
